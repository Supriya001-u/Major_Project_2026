# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Model weights and checkpoint files (Do not commit large binary weights to Git)
*.pt
*.pth
*.weights
*.onnx
*.engine
*.tflite
models/weights/
weights/

# Video files and raw traffic footage (Exclude large media)
*.mp4
*.avi
*.mov
*.mkv
*.flv
*.wmv
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
temp_uploads/

# Output evaluation runs, prediction videos, and logs
runs/
results/*.mp4
results/*.avi
results/*.png
!results/.gitkeep
results/*.csv
!results/benchmark_template.csv
*.log

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
